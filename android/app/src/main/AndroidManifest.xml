<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ReplyMate AI's own notifications (status / all-keys-failed alerts).
         Separate from notification-listener access: one never implies the
         other (docs/ANDROID_NATIVE_SERVICES.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Floating reply bubble (docs/FLOATING_OVERLAY.md §6). All three are
         optional: without SYSTEM_ALERT_WINDOW the bubble simply never shows and
         the fallback notification takes over. Granting overlay access never
         implies - and is never treated as - notification access. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <!--
        allowBackup is false on purpose, and it is a privacy rule, not a
        default left alone. Conversation memory (docs/CONVERSATION_MEMORY.md)
        is the one place this app writes message text to storage, and it
        promises that text never leaves the device. Android Auto Backup would
        quietly upload app-private files to the user's Drive - a promise kept
        on-device and broken in the cloud is worse than no promise, so the
        store is not eligible for backup at all.
    -->
    <application
        android:label="ReplyMate AI"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Entry point 2: long-press -> select text in another app and
                 "ReplyMate AI" appears in the floating selection menu. The
                 selected text arrives as EXTRA_PROCESS_TEXT. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Entry point 3: the share sheet of any app that can share text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- Entry point 1: notification-based message context. The binding
             permission is Android's own; the user still grants access through
             Settings, and only after the permission screen explained why. -->
        <service
            android:name=".ReplyMateNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- The reply panel: translucent, task-excluded, and not exported, so
             nothing but our own bubble can open it. -->
        <!-- Its own task affinity on purpose: the panel must not join the main
             app's task. Sharing a task meant closing the panel dropped the user
             into ReplyMate instead of back into WhatsApp - the exact annoyance
             that made the bubble feel like it "takes you to the app". With a
             task of its own, dismissing the panel returns to whatever was on
             screen before it. -->
        <activity
            android:name=".OverlayPanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.keshabstudios.replymate.panel"
            android:theme="@style/OverlayPanelTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Entry point 2: the screen itself. Off by default, allowlist-bound
             and read-only - see docs/SCREEN_READING.md. The binding permission
             is Android's own; the user grants access in Settings, and only
             after the in-app disclosure explained what it means. Android shows
             its own warning for any service that can read window content, and
             this one claims nothing it is not: no isAccessibilityTool, no
             gestures, no actions on the user's behalf. -->
        <service
            android:name=".ReplyMateScreenReaderService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_reader_service_config" />
        </service>

        <!-- The bubble itself: a tiny WindowManager view kept alive by a
             foreground service. `specialUse` is declared honestly (and must be
             declared in Play Console) because no narrower FGS type covers
             "draw a floating shortcut over other apps". -->
        <service
            android:name=".OverlayBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating reply bubble for messages the user allows" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Package visibility for the app-selection screen: ReplyMate only
             offers apps it can actually see installed (Android 11+ rules).
             Deliberately NOT QUERY_ALL_PACKAGES: Play discourages it and the
             candidate list is fixed and small. -->
        <package android:name="com.whatsapp"/>
        <package android:name="org.telegram.messenger"/>
        <package android:name="com.facebook.orca"/>
        <package android:name="org.thoughtcrime.securesms"/>
        <package android:name="com.google.android.apps.messaging"/>
        <package android:name="com.android.mms"/>
    </queries>
</manifest>
