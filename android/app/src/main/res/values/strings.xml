<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native copy. Every string here is deliberately content-free: the bubble
         and the fallback notification name the feature or the app, never the
         sender and never the message (docs/FLOATING_OVERLAY.md §9). -->
    <string name="overlay_bubble_description">ReplyMate reply bubble. Tap to draft a reply, drag to move, drag to the screen edge to hide it.</string>
    <string name="overlay_bubble_menu_reply">Draft a reply</string>
    <string name="overlay_bubble_menu_hide">Hide at the edge</string>
    <string name="overlay_bubble_menu_dismiss">Dismiss until the next message</string>
    <string name="overlay_bubble_description_collapsed">ReplyMate bubble, hidden at the screen edge. Tap to bring it back.</string>
    <string name="overlay_bubble_expand">Bring the bubble back</string>
    <string name="overlay_bubble_menu_description">Bubble actions: draft a reply, hide at the edge, or dismiss</string>
    <!-- Shown by the app (not by the bubble) after a swipe dismissal. Names no
         sender and no message, so the undo window stays content-free. -->
    <string name="overlay_bubble_dismissed">Bubble dismissed. The message is still waiting.</string>
    <string name="overlay_bubble_undo">Undo</string>

    <!-- The bubble's opt-in preview (off by default). The honest states below
         exist so the pill never guesses at words the notification did not give
         us; there is no placeholder that pretends to be a message. -->
    <string name="overlay_preview_redacted">Hidden content - open to read</string>
    <string name="overlay_preview_group">Group message</string>
    <string name="overlay_preview_empty">New message</string>
    <string name="overlay_channel_name">Reply bubble</string>
    <string name="overlay_channel_description">Keeps the floating reply bubble available while you use other apps.</string>
    <string name="overlay_notification_title">Reply bubble active</string>
    <string name="overlay_notification_text">Tap the bubble to draft a reply. Turn this off in ReplyMate settings.</string>

    <string name="overlay_fallback_channel_name">New messages</string>
    <string name="overlay_fallback_channel_description">Tells you when a message arrives from an app you allowed, so you can draft a reply.</string>
    <!-- %1$s = the messaging app's label. Never the message. -->
    <string name="overlay_fallback_title">New message from %1$s</string>
    <string name="overlay_fallback_text">Draft a reply</string>

    <!-- Screen reader. Android shows these on its own accessibility screen, so
         they are written for someone who has not read our docs: what is read,
         what is never sent, and what is never kept. -->
    <string name="screen_reader_summary">Draft replies from the conversation you already have open.</string>
    <string name="screen_reader_description">Reads the newest message shown on the screen of the messaging apps you choose, so ReplyMate can draft a reply even when the app posts no notification because you are already in the chat. ReplyMate never sends anything, never types into another app, and keeps nothing: the text lives in memory only and is gone when the app closes. You can turn this off at any time.</string>
</resources>
